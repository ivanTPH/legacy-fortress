{
  "name": "legacy-fortress-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "audit:routes": "node scripts/route-audit.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "crawl:links": "node scripts/link-crawler.mjs",
    "matrix:routes": "node scripts/generate-route-matrix.mjs",
    "test": "npm run test:unit",
    "test:unit": "npm run test:core && npm run test:stabilisation && node --test tests/admin-phase1-foundation.test.mjs",
    "test:navigation": "node --test tests/menu-key-actions.test.mjs tests/route-parity.test.mjs",
    "test:core": "node --test tests/menu-key-actions.test.mjs tests/menu-state.test.mjs tests/route-parity.test.mjs tests/auth-and-schema-guards.test.mjs tests/auth-browser-client.test.mjs tests/csp-deployment-scheme.test.mjs tests/recovery-flow.test.mjs tests/invitation-recovery.test.mjs tests/plan-framework.test.mjs tests/production-smoke-script.test.mjs tests/phase3-product-governance.test.mjs tests/phase4a-customer-dashboard-data-proof.test.mjs",
    "test:stabilisation": "node --test tests/backend-foundations.test.mjs tests/platform-architecture-stabilisation.test.mjs tests/admin-role-api-routes.test.mjs tests/dashboard-ui-consistency.test.mjs tests/access-requests-owner-flow.test.mjs tests/workspace-switcher.test.mjs tests/phase1-security-foundation.test.mjs tests/phase2-identity-verification.test.mjs",
    "test:uat:local": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:3012 playwright test tests/e2e/local-uat-review-access.spec.ts tests/e2e/admin-role-matrix-local.spec.ts --project=desktop-chromium",
    "test:uat:admin": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:3012 playwright test tests/e2e/admin-role-matrix-local.spec.ts --project=desktop-chromium",
    "release:check": "node scripts/release-gate.mjs",
    "test:e2e": "playwright test",
    "smoke:auth:reliability": "node scripts/smoke-auth-reliability.mjs",
    "smoke:contacts:invitations": "node scripts/smoke-contacts-invitations.mjs",
    "smoke:error:recovery": "node scripts/smoke-error-recovery.mjs",
    "smoke:mobile:core": "node scripts/smoke-mobile-core.mjs",
    "smoke:mobile:polish": "node scripts/smoke-mobile-polish.mjs",
    "smoke:authenticated:ux": "node scripts/smoke-authenticated-ux.mjs",
    "smoke:production:core": "node scripts/smoke-production-core.mjs",
    "smoke:production:strict": "SMOKE_PERFORMANCE_BUDGET_STRICT=true node scripts/smoke-production-core.mjs",
    "smoke:local:dashboard-bank": "node scripts/smoke-dashboard-bank-dev.mjs",
    "smoke:owner:launch": "node scripts/smoke-owner-launch-uat.mjs",
    "uat:validate": "node scripts/validate-uat-environment.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "next": "^16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.3.0",
    "minimatch": "^10.2.6",
    "minimatch@10.2.4": {
      "brace-expansion": "^5.0.8"
    },
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "ws": "^8.21.0",
    "brace-expansion": "^5.0.9"
  }
}
